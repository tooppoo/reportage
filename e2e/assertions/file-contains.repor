case "file contains succeeds when the substring is present" {
  write <"result.json"> ```
    {"status":"passed"}
    ```
  $ true

  assert {
    exit 0
    file <"result.json"> contains "\"status\":\"passed\""
  }
}

case "file contains fails when the substring is absent" {
  write <"inner.repor"> ```
    case "inner" {
      $ printf '{"status":"fail"}' > result.json
      assert {
        file <"result.json"> contains "passed"
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 1
    stderr contains "assertion.file.contains.mismatch"
  }
}

case "file contains fails for a missing file" {
  write <"inner.repor"> ```
    case "inner" {
      $ true
      assert {
        file <"missing.txt"> contains "anything"
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 1
  }
}

case "a wrong-kind expected literal names both text forms file contains accepts" {
  write <"inner.repor"> ```
    case "inner" {
      $ true
      assert {
        file <"out.txt"> contains <"expected.txt">
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 2
    stderr contains "semantic.literal.kind_mismatch"
    stderr contains "use a string literal or heredoc literal (e.g. \"expected.txt\") instead"
  }
}

case "the heredoc literal that suggestion names is genuinely accepted" {
  write <"expected.txt"> ```
    hello
    ```

  $ true

  assert {
    file <"expected.txt"> contains ```
      hello
      ```
  }
}
