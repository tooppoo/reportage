# `reportage docs` (issues #170, #257): the product-facing documentation
# generation flow. Sources selected by glob are parsed — never executed — and
# projected into a single plain text document at <out-dir>/index.txt describing
# the product under test, not the Reportage DSL that tests it. The exact
# serialization contract is fixed by tests/fixtures/docs-product/*/index.snapshot.txt;
# these cases verify the CLI-observable flow: exit code, stdout mutation report,
# generated file, the product projection, and the absence of execution side
# effects.

# The shape the projection exists for: a file the reader prepares, a command
# they run, and the conditions the run is verified to satisfy — all in the
# order the scenario wrote them.
case "a write, a command, and an assertion become file, command, and verified outcome" {
  write <"src/init.repor"> ```
    document file {
      title "Project setup"
      group "Getting started"
      description "How a project is created."
    }

    document case {
      title "Initializing a project"
      description "Creates the config file."
    }

    case "init" {
      write <"demo.kdl"> "name \"demo\"\n"
      $ demo init
      assert {
        exit 0
        stdout contains "created"
        file <"demo.kdl"> exists
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out

  assert {
    exit 0
    stdout contains "generated: out/index.txt"
    file <"out/index.txt"> exists
    file <"out/index.txt"> contains "Getting started"
    file <"out/index.txt"> contains "Project setup"
    file <"out/index.txt"> contains "How a project is created."
    file <"out/index.txt"> contains "Initializing a project"
    file <"out/index.txt"> contains "Creates the config file."
    file <"out/index.txt"> contains ```
      File
        demo.kdl
          name "demo"
      ```
    file <"out/index.txt"> contains ```
      Command
        demo init
      ```
    file <"out/index.txt"> contains ```
      Verified outcome
        the exit code is 0
        standard output contains "created"
        "demo.kdl" exists
      ```
  }
}

# A reportage assertion verifies the current checkpoint, not the action before
# it, so the projection keeps the interleaving instead of pairing each
# assertion with one command: two commands before one checkpoint stay two, and
# a second checkpoint stays separate.
case "multiple commands and checkpoints keep their order" {
  write <"src/order.repor"> ```
    case "multi" {
      $ first-command
      $ second-command
      assert {
        exit 0
      }
      $ third-command
      assert {
        stderr empty
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out

  assert {
    exit 0
    file <"out/index.txt"> contains ```
      Command
        first-command

      Command
        second-command

      Verified outcome
        the exit code is 0

      Command
        third-command

      Verified outcome
        standard error is empty
      ```
  }
}

# `before_each` is shared setup, so it reaches every example as preparation —
# and the Reportage-specific name never appears.
case "before_each is projected as each example's preparation" {
  write <"src/setup.repor"> ```
    before_each {
      write <"seed.txt"> "seed"
      $ prepare-workspace
    }

    case "uses the seed" {
      $ run-with-seed
      assert {
        exit 0
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out

  assert {
    exit 0
    file <"out/index.txt"> contains ```
      Preparation

      File
        seed.txt
          seed

      Command
        prepare-workspace

      Steps

      Command
        run-with-seed
      ```
    not {
      file <"out/index.txt"> contains "before_each"
    }
  }
}

# The product document never shows the DSL that produced it: no case, assert,
# before_each, or write wrapper, and no `.repor` path.
case "no Reportage DSL wrapper appears in the product document" {
  write <"src/a.repor"> ```
    before_each {
      write <"seed.txt"> "seed"
    }

    case "documented" {
      write <"config.kdl"> "name \"demo\"\n"
      $ demo init
      assert {
        exit 0
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out

  assert {
    exit 0
    not {
      file <"out/index.txt"> contains "case \"documented\" {"
    }
    not {
      file <"out/index.txt"> contains "assert {"
    }
    not {
      file <"out/index.txt"> contains "before_each {"
    }
    not {
      file <"out/index.txt"> contains "write <"
    }
    not {
      file <"out/index.txt"> contains ".repor"
    }
  }
}

# `**` recurses into subdirectories — directories are never recursed into
# implicitly — and every selected source lands in the one document, ordered by
# the shared `document file` ordering contract.
case "a ** pattern collects nested sources into one document in order" {
  write <"src/second.repor"> ```
    document file {
      title "Second section"
      group "Guides"
      order 2
    }

    case "second" {
      $ second-command
      assert {
        exit 0
      }
    }
    ```

  write <"src/nested/first.repor"> ```
    document file {
      title "First section"
      group "Guides"
      order 1
    }

    case "first" {
      $ first-command
      assert {
        exit 0
      }
    }
    ```

  $ reportage docs 'src/**/*.repor' --out-dir out

  assert {
    exit 0
    stdout contains "generated: out/index.txt"
    file <"out/index.txt"> contains ```
      Section
        First section

      Example
        first

      Command
        first-command

      Verified outcome
        the exit code is 0

      Section
        Second section
      ```
  }
}

# An empty expected value has no useful delimited form, so it is named. `""` is
# a valid expected value, so the wording has to be stated rather than left to a
# format's quoting.
case "an empty expected value is named rather than quoted" {
  write <"src/empty-value.repor"> ```
    case "empty expected value" {
      $ run
      assert {
        stdout contains ""
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out

  assert {
    exit 0
    file <"out/index.txt"> contains ```
      Verified outcome
        standard output contains the empty string
      ```
  }
}

# Sources without document blocks fall back to the file stem as title, the
# fixed default group `Index`, and the case name as example title.
case "documentation-free sources fall back to stem, Index group, and case names" {
  write <"src/fallback-source.repor"> ```
    case "fallback case name" {
      $ run
      assert {
        exit 0
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out

  assert {
    exit 0
    file <"out/index.txt"> contains "Index"
    file <"out/index.txt"> contains "fallback-source"
    file <"out/index.txt"> contains "fallback case name"
  }
}

# A valid source with zero cases has no example to document, so only its
# metadata appears; generation succeeds.
case "a source with zero cases still generates index.txt" {
  write <"src/empty.repor"> ```
    document file {
      title "Case-less"
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out

  assert {
    exit 0
    file <"out/index.txt"> contains "Case-less"
    not {
      file <"out/index.txt"> contains "Example"
    }
  }
}

# The document format and layout default to `plain` and `single-file`, so the
# explicit flags produce the same output path.
case "explicit --format plain and --layout single-file match the defaults" {
  write <"src/a.repor"> ```
    case "one" {
      $ run
      assert {
        exit 0
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out --format plain --layout single-file

  assert {
    exit 0
    stdout contains "generated: out/index.txt"
    file <"out/index.txt"> exists
  }
}

# `--index-file-name` renames the generated index document. The value is used
# verbatim including its extension, so it need not match the `--format`
# extension: no default `index.md` is written alongside it.
case "--index-file-name writes the document under the given name" {
  write <"src/a.repor"> ```
    case "one" {
      $ run
      assert {
        exit 0
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out --format markdown --index-file-name readme.md

  assert {
    exit 0
    stdout contains "generated: out/readme.md"
    file <"out/readme.md"> exists
    file <"out/readme.md"> contains "# Documentation"
    not {
      file <"out/index.md"> exists
    }
  }
}

# The value is used verbatim: a name without an extension produces an
# extension-less file, and no default `index.txt` appears beside it.
case "--index-file-name without an extension produces an extension-less file" {
  write <"src/a.repor"> ```
    case "one" {
      $ run
      assert {
        exit 0
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out --index-file-name overview

  assert {
    exit 0
    stdout contains "generated: out/overview"
    file <"out/overview"> exists
    not {
      file <"out/index.txt"> exists
    }
  }
}

# Documentation generation parses sources but never executes them: the case
# action must not run, and no execution artifact directory may appear.
case "sources are not executed and no artifacts are generated" {
  write <"src/side-effect.repor"> ```
    case "would create a marker file" {
      $ touch marker.txt
      assert {
        exit 0
      }
    }
    ```

  $ reportage docs 'src/*.repor' --out-dir out

  assert {
    exit 0
    not {
      file <"marker.txt"> exists
    }
    not {
      dir <".reportage"> exists
    }
  }
}
