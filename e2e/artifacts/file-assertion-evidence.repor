
case "file-exist requir subject" {
  write <"tmp-file-missing-subject.repor"> ```
    case "inner" {
      $ true
      assert {
        file exists
      }
    }
    ```

  $ reportage tmp-file-missing-subject.repor

  assert {
    exit 2
    stderr contains "parse.syntax"
  }
}

case "file assertion verifies artifact evidence" {
  $ rm -rf \
    .reportage \
    tmp-file-assertion-selftest

  write <"tmp-file-assertion-selftest/inner.repor"> ```
    case "inner" {
      $ true
      assert {
        exit 0
      }
    }
    ```

  $ reportage --debug-run-id file-assertion-selftest tmp-file-assertion-selftest/inner.repor

  assert {
    exit 0
    file <".reportage/runs/file-assertion-selftest/result.json"> exists
    file <".reportage/runs/file-assertion-selftest/result.json"> contains "\"status\": \"passed\""
  }
}

case "file assertion verifies failed-run artifact evidence" {
  $ rm -rf \
    .reportage \
    tmp-file-assertion-failure-selftest

  write <"tmp-file-assertion-failure-selftest/inner.repor"> ```
    case "inner failure" {
      $ false
      assert {
        exit 0
      }
    }
    ```

  $ reportage --debug-run-id file-assertion-failure-selftest tmp-file-assertion-failure-selftest/inner.repor

  assert {
    exit 1
    file <".reportage/runs/file-assertion-failure-selftest/result.json"> exists
    file <".reportage/runs/file-assertion-failure-selftest/result.json"> contains "\"status\": \"failed\""
  }
}
