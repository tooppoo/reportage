# `before_each` case-local setup (#70, #227): setup runs inside each concrete
# case's own workspace before its body, using the same `$` action, `assert`
# block, and `write` step a case body uses.

case "before_each files are visible to the case body's first assertion block" {
  write <"inner.repor"> ```
    before_each {
      write <"seed.txt"> "seed\n"
    }

    case "asserts setup before any action" {
      assert {
        file <"seed.txt"> exists
        file <"seed.txt"> contains "seed"
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 0
    stdout contains "PASS"
  }
}

case "before_each replays into each concrete case's isolated workspace" {
  write <"inner.repor"> ```
    before_each {
      write <"seed.txt"> "seed\n"
    }

    case "consumes the seed" {
      $ rm seed.txt
      assert {
        exit 0
      }
    }

    case "gets a fresh seed" {
      assert {
        file <"seed.txt"> exists
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 0
  }
}

case "a heredoc write in before_each seeds a multi-line file" {
  write <"inner.repor"> `````
    before_each {
      write <"reportage.kdl"> ```
        reportage {
          config {
            version 1
          }
        }
        ```
    }

    case "reads the seeded config" {
      $ cat reportage.kdl
      assert {
        exit 0
        stdout contains "version 1"
      }
    }
    `````

  $ reportage inner.repor

  assert {
    exit 0
  }
}

case "a second before_each block is a parse error" {
  write <"inner.repor"> ```
    before_each {
      write <"a.txt"> "a\n"
    }

    before_each {
      write <"b.txt"> "b\n"
    }

    case "never runs" {
      $ true
      assert {
        exit 0
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 2
    stderr contains "parse.before_each.duplicate"
  }
}

case "before_each after a case is a parse error" {
  write <"inner.repor"> ```
    case "runs first" {
      $ true
      assert {
        exit 0
      }
    }

    before_each {
      write <"seed.txt"> "seed\n"
    }
    ```

  $ reportage inner.repor

  assert {
    exit 2
    stderr contains "parse.before_each.after_case"
  }
}

case "before_each runs an action, verifies it, and writes from its result" {
  write <"inner.repor"> ```
    before_each {
      $ mkdir -p fixtures
      assert {
        exit 0
        dir <"fixtures"> exists
      }

      write <"fixtures/seed.txt"> "seed\n"
    }

    case "reads what the setup produced" {
      $ cat fixtures/seed.txt
      assert {
        exit 0
        stdout contains "seed"
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 0
    stdout contains "PASS"
  }
}

case "a case body's first workspace assertion observes a before_each action" {
  write <"inner.repor"> ```
    before_each {
      $ echo setup > from-setup.txt
      assert {
        exit 0
      }
    }

    case "sees the setup action's workspace effect before acting" {
      assert {
        file <"from-setup.txt"> contains "setup"
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 0
    stdout contains "PASS"
  }
}

case "a case body's first process expectation cannot read the setup action" {
  write <"inner.repor"> ```
    before_each {
      $ echo setup
      assert {
        exit 0
      }
    }

    case "asks for an exit code it never produced" {
      assert {
        exit 0
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 2
    stderr contains "semantic.expectation.requires_action"
  }
}

case "a failing before_each assertion fails its case without running the body" {
  write <"inner.repor"> ```
    before_each {
      $ false
      assert {
        exit 0
      }
    }

    case "never runs its body" {
      $ touch body-ran.txt
      assert {
        file <"body-ran.txt"> exists
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 1
    stdout contains "FAIL"
    stderr contains "before_each assertion block at step 2"
    stderr contains "assertion.exit.equals.mismatch"
  }
}

case "a before_each assertion does not satisfy a case body's assertion requirement" {
  write <"inner.repor"> ```
    before_each {
      write <"seed.txt"> "seed\n"
      assert {
        file <"seed.txt"> exists
      }
    }

    case "verifies nothing of its own" {
      $ cat seed.txt
    }
    ```

  $ reportage inner.repor

  assert {
    exit 2
    stderr contains "parse.missing_assertion_block"
  }
}

case "an empty before_each block is a parse error" {
  write <"inner.repor"> ```
    before_each {
    }

    case "never runs" {
      $ true
      assert {
        exit 0
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 2
    stderr contains "parse.before_each.empty"
  }
}

case "a failing before_each step names the block and its step position" {
  write <"inner.repor"> ```
    before_each {
      write <"a.txt"> "first\n"
      write <"a.txt"> "second\n"
    }

    case "never runs its body" {
      $ true
      assert {
        exit 0
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 3
    stderr contains "before_each write step at step 2"
    stderr contains "step.write.target_exists"
    stderr contains "never runs its body"
  }
}

case "a case body write to a before_each path is a runtime step error" {
  write <"inner.repor"> ```
    before_each {
      write <"a.txt"> "from before_each\n"
    }

    case "writes the same path again" {
      write <"a.txt"> "from the case body\n"
      assert {
        file <"a.txt"> exists
      }
    }
    ```

  $ reportage inner.repor

  assert {
    exit 3
    stderr contains "step.write.target_exists"
  }
}
